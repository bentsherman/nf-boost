#!/usr/bin/env python3

import argparse
import json
import os


def load(file_path):
    with open(file_path, 'r') as f:
        return [int(line.strip()) for line in f]


def metrics(x, interval):
    gb = 1 << 30
    return {
        'peak_gb': max(x) / gb,
        'final_gb': x[-1] / gb,
        'auc_gb_hours': sum(x) * interval / 3600 / gb,
    }


def plot(ys, labels, interval, outfile):
    import matplotlib.pyplot as plt
    import pandas as pd

    ys = pd.concat([pd.Series(y) for y in ys], axis='columns').ffill()

    for i in ys:
        plt.plot(ys.index * interval, ys[i] / (1 << 20), label=labels[i])

    plt.xlabel('time (s)')
    plt.ylabel('disk usage (MB)')
    plt.ylim(bottom=0)
    plt.legend()

    plt.savefig(outfile)
    plt.close()


if __name__ == '__main__':
    # parse command-line arguments
    parser = argparse.ArgumentParser(description='Print disk usage metrics for one or more runs as JSON.')
    parser.add_argument('inputs', help='disk usage file from the watch script', nargs='+')
    parser.add_argument('--plot', help='also save a time series plot to this file')

    args = parser.parse_args()

    # sampling interval used by the watch script
    interval = float(os.environ.get('WATCH_INTERVAL', '1'))

    # load disk usage for each run
    ys = [load(f) for f in args.inputs]
    labels = [os.path.splitext(os.path.basename(f))[0] for f in args.inputs]

    # print metrics for each run
    result = { label: metrics(y, interval) for label, y in zip(labels, ys) }
    print(json.dumps(result, indent=2))

    if args.plot:
        plot(ys, labels, interval, args.plot)
